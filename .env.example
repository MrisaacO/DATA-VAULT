# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.

# --- Core Django settings ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- File upload limits / allowed types (Section 25.4) ---
MAX_UPLOAD_SIZE_MB=250
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.mp4,.mov,.mp3,.wav,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip

# --- Recycle bin retention (Section 14.1) ---
RECYCLE_BIN_RETENTION_DAYS=30

# --- PostgreSQL (used only by config.settings.prod) ---
DATABASE_URL=postgres://vault_user:vault_password@localhost:5432/personal_data_vault

# --- Object storage (used only by config.settings.prod, Section 11.2 / 12) ---
OBJECT_STORAGE_BUCKET=personal-data-vault-prod
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
